[Unit]
Description=CP3 Airflow Docker Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/cp3-airflow
ExecStart=/usr/bin/docker compose up -d postgres airflow-api-server airflow-scheduler airflow-dag-processor
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

